# Copy to .env and fill in real values. Never commit real secrets.
# Local dev defaults match docker-compose.yml.

# --- Core ---
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:4001,http://localhost:4002
# Proxy hops to trust for the client IP. Default 0 in development, 1 in production (one load balancer).
# The web apps proxy /api/v1 through Next.js, so set 1 when the browser reaches the API that way.
# TRUST_PROXY_HOPS=1

# --- Database (PostgreSQL + PostGIS) ---
# 5544 avoids clashing with native Windows Postgres instances on 5432/5433
DATABASE_URL=postgresql://urgent:urgent@localhost:5544/urgent_ng?schema=public

# --- Redis / BullMQ ---
# 6399 avoids clashing with native Windows Redis instances on 6379/6380
REDIS_URL=redis://localhost:6399

# --- Auth ---
# In production every secret below must be at least 32 characters (enforced at boot).
JWT_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value

# --- Data protection ---
# DATA_ENCRYPTION_KEY encrypts sensitive columns (errand contact phone numbers).
# HMAC_SECRET derives errand location offsets and identity de-duplication hashes.
DATA_ENCRYPTION_KEY=replace-with-a-32-plus-character-random-value
HMAC_SECRET=replace-with-another-32-plus-character-random-value

# --- Vendors ---
# There is no fake/real switch. The app uses the vendors below in development and in production,
# and will not start until their keys are set (the error names each missing variable). The
# automated tests (NODE_ENV=test) run on in-process stand-ins and need none of them.

# --- AWS S3 (media storage) ---
# The bucket must be private. Uploads go browser -> API (PUT /api/v1/media/{id}/content) -> bucket,
# so the bucket needs no CORS rule and no public access.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# --- Paystack (platform purchases: credits, Runner Pro, boosts, verification) ---
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Optional. Defaults to https://api.paystack.co
PAYSTACK_BASE_URL=
# Where Paystack sends the customer after checkout (the web app's order page). Optional.
PAYSTACK_CALLBACK_URL=

# --- Mailgun (transactional email) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

# --- SMS / OTP delivery (phone OTP) ---
# Termii (SMS). Leave both empty while there is no SMS vendor: outside production the one-time
# code is then written to the backend log (look for "one-time code for"). Required in production.
SMS_API_KEY=
SMS_SENDER_ID=

# --- Firebase FCM (push notifications) ---
# The service account JSON (or the same JSON base64-encoded). Required.
FIREBASE_CREDENTIALS=

# --- Maps provider (geocoding / distance): Google Maps Platform ---
# Required. A SERVER key: enable the Geocoding API and the Distance
# Matrix API, restrict it by IP address. Do not reuse the browser key (NEXT_PUBLIC_GOOGLE_MAPS_API_KEY).
MAPS_API_KEY=

# --- KYC provider: Dojah (NIN + selfie verification) ---
# Required.
# Sandbox: https://sandbox.dojah.io   Production: https://api.dojah.io
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=

# Google sign-in. Needed for the "Continue with Google" button; with no client id the route answers 503.
GOOGLE_CLIENT_ID=
