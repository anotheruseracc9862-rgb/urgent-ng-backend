# Copy to .env and fill in real values. Never commit real secrets.
# Local dev defaults match docker-compose.yml.

# --- Core ---
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# --- Database (PostgreSQL + PostGIS) ---
# 5544 avoids clashing with native Windows Postgres instances on 5432/5433
DATABASE_URL=postgresql://urgent:urgent@localhost:5544/urgent_ng?schema=public

# --- Redis / BullMQ ---
# 6399 avoids clashing with native Windows Redis instances on 6379/6380
REDIS_URL=redis://localhost:6399

# --- Auth ---
# In production every secret below must be at least 32 characters (enforced at boot).
JWT_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value

# --- Data protection ---
# DATA_ENCRYPTION_KEY encrypts sensitive columns (errand contact phone numbers).
# HMAC_SECRET derives errand location offsets and identity de-duplication hashes.
DATA_ENCRYPTION_KEY=replace-with-a-32-plus-character-random-value
HMAC_SECRET=replace-with-another-32-plus-character-random-value

# --- Provider modes ---
# Not needed. Vendors are "fake" when NODE_ENV is development or test, and "real" in
# production (production refuses "fake"). Uncomment one line only to try a live vendor
# in development; it then needs that vendor's keys below.
# KYC_PROVIDER=real
# MAPS_PROVIDER=real
# SMS_PROVIDER=real
# EMAIL_PROVIDER=real
# PUSH_PROVIDER=real
# STORAGE_PROVIDER=real
# PAYMENTS_PROVIDER=real

# --- AWS S3 (media storage) ---
# Required only when STORAGE_PROVIDER=real. The bucket must be private.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# --- Paystack (platform purchases: credits, Runner Pro, boosts, verification) ---
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Mailgun (transactional email) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

# --- SMS / OTP delivery (phone OTP) ---
SMS_API_KEY=
SMS_SENDER_ID=

# --- Firebase FCM (push notifications) ---
# The service account JSON (or the same JSON base64-encoded). Required only when PUSH_PROVIDER=real.
FIREBASE_CREDENTIALS=

# --- Maps provider (geocoding / distance) ---
MAPS_API_KEY=

# --- KYC provider: Dojah (NIN + selfie verification) ---
# Required only when KYC_PROVIDER=real.
# Sandbox: https://sandbox.dojah.io   Production: https://api.dojah.io
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=
