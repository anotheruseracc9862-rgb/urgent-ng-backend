# Production environment checklist. Copy the values into your host's secret store (not into git).
# The backend refuses to start in production if a required value is missing or too short, and the
# error names each one. The API, the worker and the scheduler all need the same variables.

# --- Core (required) ---
NODE_ENV=production
PORT=4000
# Public https addresses. Email links and the email logo use them, and the web and admin origins are
# the only browser origins allowed to call the API (there is no separate CORS setting).
WEB_APP_URL=https://app.example.com
API_PUBLIC_URL=https://api.example.com
# Optional: the admin app. Its origin is allowed to call the API, and admin invitation emails link here.
ADMIN_APP_URL=https://admin.example.com
# Proxies in front of the API (load balancer, CDN, the Next.js proxy). Default in production is 1.
TRUST_PROXY_HOPS=1

# --- Database and Redis (required) ---
# Managed PostgreSQL with PostGIS enabled. Run `npx prisma migrate deploy` before the first start.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/urgent_ng?schema=public&sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# --- Secrets (required, 32+ characters each, all different, generated fresh for production) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# DATA_ENCRYPTION_KEY and HMAC_SECRET cannot be changed once users exist: stored contact phones and
# identity hashes depend on them.
JWT_SECRET=
JWT_REFRESH_SECRET=
DATA_ENCRYPTION_KEY=
HMAC_SECRET=

# --- Vendors (required, production accounts and keys) ---
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

PAYSTACK_PUBLIC_KEY=pk_live_
PAYSTACK_SECRET_KEY=sk_live_
# Optional: falls back to PAYSTACK_SECRET_KEY. Add the webhook URL in the Paystack dashboard.
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=https://app.example.com/checkout

# Termii. Both required in production.
SMS_API_KEY=
SMS_SENDER_ID=

# SMTP. MAIL_FROM must be on a domain you verified with the provider.
MAIL_FROM=Urgent.ng <noreply@example.com>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=

# Production Firebase service account (JSON, or the same JSON base64-encoded).
FIREBASE_CREDENTIALS=

# Server key, restricted by IP, with the Geocoding and Distance Matrix APIs enabled.
MAPS_API_KEY=

# Dojah production: https://api.dojah.io (the sandbox is https://sandbox.dojah.io).
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://api.dojah.io

# Add the production web origin to this client's authorised JavaScript origins.
GOOGLE_CLIENT_ID=
