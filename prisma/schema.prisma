// Urgent.ng — canonical enums from the Backend Domain Rules & Data Contracts
// PRD (§4). Models are added module-by-module as implementation proceeds.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

