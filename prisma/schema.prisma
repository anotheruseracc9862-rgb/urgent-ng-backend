// P7-01: assignment and execution (Backend PRD 14, 15, 16, A.7). Migration
// 20261016000000_assignments_and_execution adds the partial unique indexes, the status CHECKs and
// the triggers that Prisma cannot express; they are known drift in `prisma migrate diff`.
// Errand status is the execution status: there is no separate column (Backend PRD 15.1).
model Assignment {
  id                 String                    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  errandId           String                    @map("errand_id") @db.Uuid
  errand             Errand                    @relation(fields: [errandId], references: [id], onDelete: Restrict)
  requesterId        String                    @map("requester_id") @db.Uuid
  requester          User                      @relation("AssignmentRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  runnerId           String                    @map("runner_id") @db.Uuid
  runner             User                      @relation("AssignmentRunner", fields: [runnerId], references: [id], onDelete: Restrict)
  selectedOfferId    String                    @map("selected_offer_id") @db.Uuid
  selectedOffer      Offer                     @relation(fields: [selectedOfferId], references: [id], onDelete: Restrict)
  status             AssignmentStatus          @default(PENDING_ACCEPTANCE)
  agreedAmountMinor  BigInt                    @map("agreed_amount_minor")
  currency           String                    @default("NGN")
  selectedAt         DateTime                  @map("selected_at") @db.Timestamptz(3)
  acceptanceDeadline DateTime                  @map("acceptance_deadline") @db.Timestamptz(3)
  acceptedAt         DateTime?                 @map("accepted_at") @db.Timestamptz(3)
  declinedAt         DateTime?                 @map("declined_at") @db.Timestamptz(3)
  timedOutAt         DateTime?                 @map("timed_out_at") @db.Timestamptz(3)
  cancelledAt        DateTime?                 @map("cancelled_at") @db.Timestamptz(3)
  completedAt        DateTime?                 @map("completed_at") @db.Timestamptz(3)
  locationSharingStoppedAt DateTime?           @map("location_sharing_stopped_at") @db.Timestamptz(3)
  cancelledBy        String?                   @map("cancelled_by") @db.Uuid
  cancelledByType    AuditActorType?           @map("cancelled_by_type")
  cancellationReason ErrandCancellationReason? @map("cancellation_reason")
  cancellationNote   String?                   @map("cancellation_note")
  cancelledStage     ErrandStatus?             @map("cancelled_stage")
  version            Int                       @default(0)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?                 @map("deleted_at") @db.Timestamptz(3)

  paymentAgreement PaymentAgreement?
  executionEvents  ExecutionEvent[]
  problems         ExecutionProblem[]
  checkpoints      Checkpoint[]
  changeRequests   ChangeRequest[]
  ratings          Rating[]

  @@index([runnerId, status], map: "assignments_runner_status_idx")
  @@index([requesterId, status], map: "assignments_requester_status_idx")
  @@index([errandId], map: "assignments_errand_idx")
  @@map("assignments")
}

model PaymentAgreement {
  assignmentId           String         @id @map("assignment_id") @db.Uuid
  assignment             Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  agreedAmountMinor      BigInt         @map("agreed_amount_minor")
  currency               String         @default("NGN")
  paymentMethod          PaymentMethod? @map("payment_method")
  paymentTiming          PaymentTiming? @map("payment_timing")
  confirmedByRequesterAt DateTime?      @map("confirmed_by_requester_at") @db.Timestamptz(3)
  confirmedByRunnerAt    DateTime?      @map("confirmed_by_runner_at") @db.Timestamptz(3)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?      @map("deleted_at") @db.Timestamptz(3)

  @@map("payment_agreements")
}

/// Append-only. The database rejects UPDATE and DELETE.
model ExecutionEvent {
  id           String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  assignmentId String             @map("assignment_id") @db.Uuid
  assignment   Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  errandId     String             @map("errand_id") @db.Uuid
  errand       Errand             @relation(fields: [errandId], references: [id], onDelete: Restrict)
  type         ExecutionEventType
  actorId      String?            @map("actor_id") @db.Uuid
  actorType    AuditActorType     @map("actor_type")
  note         String?
  mediaId      String?            @map("media_id") @db.Uuid
  media        Media?             @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  metadata     Json?
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([assignmentId, createdAt], map: "execution_events_assignment_created_idx")
  @@index([errandId, createdAt], map: "execution_events_errand_created_idx")
  @@map("execution_events")
}

model ExecutionProblem {
  id           String               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  assignmentId String               @map("assignment_id") @db.Uuid
  assignment   Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  reportedBy   String               @map("reported_by") @db.Uuid
  reporter     User                 @relation("ProblemReporter", fields: [reportedBy], references: [id], onDelete: Restrict)
  type         ExecutionProblemType
  note         String?
  mediaId      String?              @map("media_id") @db.Uuid
  media        Media?               @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  /// OPEN or RESOLVED (database CHECK).
  status       String               @default("OPEN")
  resolvedAt   DateTime?            @map("resolved_at") @db.Timestamptz(3)
  resolvedBy   String?              @map("resolved_by") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?            @map("deleted_at") @db.Timestamptz(3)

  @@index([assignmentId, status], map: "execution_problems_assignment_status_idx")
  @@map("execution_problems")
}

/// The point is private and read or written with raw SQL only.
model Checkpoint {
  id           String                                @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  assignmentId String                                @map("assignment_id") @db.Uuid
  assignment   Assignment                            @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  type         CheckpointType
  point        Unsupported("geography(Point,4326)")?
  capturedAt   DateTime                              @map("captured_at") @db.Timestamptz(3)
  note         String?
  mediaId      String?                               @map("media_id") @db.Uuid
  media        Media?                                @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  createdAt    DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([assignmentId, type], map: "checkpoints_assignment_type_unique")
  @@map("checkpoints")
}

model ChangeRequest {
  id           String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  assignmentId String              @map("assignment_id") @db.Uuid
  assignment   Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  requestedBy  String              @map("requested_by") @db.Uuid
  requester    User                @relation("ChangeRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  type         ChangeRequestType
  payload      Json
  status       ChangeRequestStatus @default(PENDING)
  respondedBy  String?             @map("responded_by") @db.Uuid
  responder    User?               @relation("ChangeResponder", fields: [respondedBy], references: [id], onDelete: Restrict)
  respondedAt  DateTime?           @map("responded_at") @db.Timestamptz(3)
  expiresAt    DateTime            @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?           @map("deleted_at") @db.Timestamptz(3)

  @@index([assignmentId, createdAt], map: "change_requests_assignment_idx")
  @@map("change_requests")
}

// Phase 8: messaging and notifications (Backend PRD 18, 19, A.8). Migration
// 20261017000000_messaging_and_notifications adds the partial unique indexes, CHECKs and the
// parties trigger that Prisma cannot express.
model Conversation {
  id             String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  errandId       String             @map("errand_id") @db.Uuid
  errand         Errand             @relation(fields: [errandId], references: [id], onDelete: Restrict)
  requesterId    String             @map("requester_id") @db.Uuid
  requester      User               @relation("ConversationRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  runnerId       String             @map("runner_id") @db.Uuid
  runner         User               @relation("ConversationRunner", fields: [runnerId], references: [id], onDelete: Restrict)
  offerId        String             @map("offer_id") @db.Uuid
  offer          Offer              @relation(fields: [offerId], references: [id], onDelete: Restrict)
  status         ConversationStatus @default(ACTIVE)
  sendDisabledAt DateTime?          @map("send_disabled_at") @db.Timestamptz(3)
  lastMessageAt  DateTime?          @map("last_message_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz(3)

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id                String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  conversationId    String       @map("conversation_id") @db.Uuid
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  userId            String       @map("user_id") @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  muted             Boolean      @default(false)
  lastReadMessageId String?      @map("last_read_message_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(3)

  @@index([userId], map: "conversation_participants_user_idx")
  @@map("conversation_participants")
}

model Message {
  id              String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  conversationId  String        @map("conversation_id") @db.Uuid
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  senderId        String        @map("sender_id") @db.Uuid
  sender          User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  type            MessageType
  body            String?
  mediaId         String?       @map("media_id") @db.Uuid
  media           Media?        @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  status          MessageStatus @default(SENT)
  clientMessageId String?       @map("client_message_id")
  deliveredAt     DateTime?     @map("delivered_at") @db.Timestamptz(3)
  readAt          DateTime?     @map("read_at") @db.Timestamptz(3)
  removedAt       DateTime?     @map("removed_at") @db.Timestamptz(3)
  removalReason   String?       @map("removal_reason")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)

  @@index([conversationId, createdAt, id], map: "messages_conversation_created_idx")
  @@index([senderId], map: "messages_sender_idx")
  @@map("messages")
}

/// Transient: a retention job removes rows after 90 days.
model Notification {
  id        String               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  user      User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  category  NotificationCategory
  type      String
  title     String
  body      String
  data      Json                 @default("{}")
  dedupeKey String?              @map("dedupe_key")
  readAt    DateTime?            @map("read_at") @db.Timestamptz(3)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt(sort: Desc)], map: "notifications_user_read_created_idx")
  @@index([createdAt], map: "notifications_created_idx")
  @@map("notifications")
}

model NotificationDelivery {
  id               String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  notificationId   String              @map("notification_id") @db.Uuid
  notification     Notification        @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  channel          NotificationChannel
  /// QUEUED, SENT, FAILED or SUPPRESSED (database CHECK).
  status           String
  suppressedReason String?             @map("suppressed_reason")
  providerRef      String?             @map("provider_ref")
  attempts         Int                 @default(0)
  lastError        String?             @map("last_error")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([notificationId, channel], map: "notification_deliveries_notification_channel_unique")
  @@map("notification_deliveries")
}

model NotificationTemplate {
  key           String               @id
  category      NotificationCategory
  titleTemplate String               @map("title_template")
  bodyTemplate  String               @map("body_template")
  active        Boolean              @default(true)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?            @map("deleted_at") @db.Timestamptz(3)

  @@map("notification_templates")
}

// P9-01: Ratings (Backend PRD 20, A.9). One per party per assignment (partial unique index in the
// migration). `revealed_at` is the blind reveal: until it is set only the rater can see the rating
// and it counts in no aggregate. Scores and edit history are never deleted.
model Rating {
  id            String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  assignmentId  String       @map("assignment_id") @db.Uuid
  assignment    Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  raterId       String       @map("rater_id") @db.Uuid
  rater         User         @relation("RatingRater", fields: [raterId], references: [id], onDelete: Restrict)
  rateeId       String       @map("ratee_id") @db.Uuid
  ratee         User         @relation("RatingRatee", fields: [rateeId], references: [id], onDelete: Restrict)
  /// REQUESTER_TO_RUNNER or RUNNER_TO_REQUESTER (database CHECK).
  direction     String
  review        String?
  status        RatingStatus @default(PUBLISHED)
  revealedAt    DateTime?    @map("revealed_at") @db.Timestamptz(3)
  editableUntil DateTime     @map("editable_until") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(3)

  scores RatingScore[]
  edits  RatingEdit[]

  @@index([rateeId, status], map: "ratings_ratee_status_idx")
  @@map("ratings")
}

model RatingScore {
  ratingId  String          @map("rating_id") @db.Uuid
  rating    Rating          @relation(fields: [ratingId], references: [id], onDelete: Restrict)
  dimension RatingDimension
  score     Int             @db.SmallInt

  @@id([ratingId, dimension])
  @@map("rating_scores")
}

model RatingEdit {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  ratingId  String   @map("rating_id") @db.Uuid
  rating    Rating   @relation(fields: [ratingId], references: [id], onDelete: Restrict)
  previous  Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ratingId], map: "rating_edits_rating_idx")
  @@map("rating_edits")
}

// P9-01: Derived aggregates (Backend PRD A.2). Rebuildable from source rows; written only by
// UserStatsService. Window-bound figures (cancellation rate, response time) are never stored here.
model UserStats {
  userId               String   @id @map("user_id") @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  completedAsRunner    Int      @default(0) @map("completed_as_runner")
  completedAsRequester Int      @default(0) @map("completed_as_requester")
  runnerRatingCount    Int      @default(0) @map("runner_rating_count")
  runnerRatingAvg      Decimal? @map("runner_rating_avg") @db.Decimal(3, 2)
  requesterRatingCount Int      @default(0) @map("requester_rating_count")
  requesterRatingAvg   Decimal? @map("requester_rating_avg") @db.Decimal(3, 2)
  paymentConductAvg    Decimal? @map("payment_conduct_avg") @db.Decimal(3, 2)
  paymentConductCount  Int      @default(0) @map("payment_conduct_count")
  badgesComputedAt     DateTime? @map("badges_computed_at") @db.Timestamptz(3)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_stats")
}

// P9-02: Reliability (Backend PRD 21.1, A.9). Append-only facts; severity is the points the event
// carries when it was written (0 for positive and neutral events). `dedupe_key` makes a retried
// consumer write each fact once. Foreign keys are in the migration.
model ReliabilityEvent {
  id           String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  errandId     String?        @map("errand_id") @db.Uuid
  assignmentId String?        @map("assignment_id") @db.Uuid
  eventType    String         @map("event_type")
  severity     Int            @db.SmallInt
  occurredAt   DateTime       @map("occurred_at") @db.Timestamptz(3)
  source       AuditActorType
  metadata     Json?
  dedupeKey    String         @unique(map: "reliability_events_dedupe_key_unique") @map("dedupe_key")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, occurredAt(sort: Desc)], map: "reliability_events_user_occurred_idx")
  @@index([userId, eventType], map: "reliability_events_user_type_idx")
  @@map("reliability_events")
}

// P9-02: A no-show report (Backend PRD 21.1 definitions). Status is PENDING, CONFIRMED, CONTESTED
// or DISMISSED (database CHECK); one open report per assignment (partial unique index).
model NoShowReport {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  assignmentId     String    @map("assignment_id") @db.Uuid
  errandId         String    @map("errand_id") @db.Uuid
  reporterId       String    @map("reporter_id") @db.Uuid
  accusedId        String    @map("accused_id") @db.Uuid
  status           String    @default("PENDING")
  note             String?
  responseDueAt    DateTime  @map("response_due_at") @db.Timestamptz(3)
  respondedAt      DateTime? @map("responded_at") @db.Timestamptz(3)
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(3)
  /// ACKNOWLEDGED, NO_RESPONSE or ADMIN (database CHECK).
  resolutionSource String?   @map("resolution_source")
  resolvedBy       String?   @map("resolved_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([assignmentId], map: "no_show_reports_assignment_idx")
  @@map("no_show_reports")
}

// P9-03: Disputes (Backend PRD 21.3, A.9). One open dispute per assignment (partial unique index in
// the migration). Opening one moves the errand to DISPUTED through ErrandStateService; resolving
// one moves it on. Foreign keys are in the migration.
model Dispute {
  id              String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  errandId        String             @map("errand_id") @db.Uuid
  assignmentId    String             @map("assignment_id") @db.Uuid
  openedBy        String             @map("opened_by") @db.Uuid
  type            DisputeType
  status          DisputeStatus      @default(OPEN)
  claim           String
  resolution      DisputeResolution?
  resolutionNotes String?            @map("resolution_notes")
  resolvedBy      String?            @map("resolved_by") @db.Uuid
  resolvedAt      DateTime?          @map("resolved_at") @db.Timestamptz(3)
  firstResponseAt DateTime?          @map("first_response_at") @db.Timestamptz(3)
  slaDueAt        DateTime?          @map("sla_due_at") @db.Timestamptz(3)
  resolutionDueAt DateTime?          @map("resolution_due_at") @db.Timestamptz(3)
  retentionHold   Boolean            @default(true) @map("retention_hold")
  assignedTo      String?            @map("assigned_to") @db.Uuid
  assignedAt      DateTime?          @map("assigned_at") @db.Timestamptz(3)
  escalatedAt     DateTime?          @map("escalated_at") @db.Timestamptz(3)
  escalatedBy     String?            @map("escalated_by") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(3)

  evidence EvidenceLink[]

  @@index([status, createdAt], map: "disputes_status_created_idx")
  @@index([errandId], map: "disputes_errand_idx")
  @@map("disputes")
}

// P9-03: Reports (Backend PRD 21.2, A.9). A persistent complaint case. An open report on an errand
// (pauses_auto_completion) holds its auto-completion.
model Report {
  id                   String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  reporterId           String           @map("reporter_id") @db.Uuid
  targetType           ReportTargetType @map("target_type")
  targetUserId         String?          @map("target_user_id") @db.Uuid
  errandId             String?          @map("errand_id") @db.Uuid
  assignmentId         String?          @map("assignment_id") @db.Uuid
  messageId            String?          @map("message_id") @db.Uuid
  ratingId             String?          @map("rating_id") @db.Uuid
  type                 ReportType
  description          String
  status               ReportStatus     @default(OPEN)
  /// UPHELD or DISMISSED (database CHECK).
  outcome              String?
  resolution           String?
  resolvedBy           String?          @map("resolved_by") @db.Uuid
  resolvedAt           DateTime?        @map("resolved_at") @db.Timestamptz(3)
  firstResponseAt      DateTime?        @map("first_response_at") @db.Timestamptz(3)
  slaDueAt             DateTime?        @map("sla_due_at") @db.Timestamptz(3)
  pausesAutoCompletion Boolean          @default(false) @map("pauses_auto_completion")
  retentionHold        Boolean          @default(false) @map("retention_hold")
  disputeId            String?          @map("dispute_id") @db.Uuid
  assignedTo           String?          @map("assigned_to") @db.Uuid
  assignedAt           DateTime?        @map("assigned_at") @db.Timestamptz(3)
  escalatedAt          DateTime?        @map("escalated_at") @db.Timestamptz(3)
  escalatedBy          String?          @map("escalated_by") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?        @map("deleted_at") @db.Timestamptz(3)

  evidence EvidenceLink[]

  @@index([status, createdAt], map: "reports_status_created_idx")
  @@map("reports")
}

model EvidenceLink {
  id         String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  disputeId  String?            @map("dispute_id") @db.Uuid
  dispute    Dispute?           @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  reportId   String?            @map("report_id") @db.Uuid
  report     Report?            @relation(fields: [reportId], references: [id], onDelete: Restrict)
  sourceType EvidenceSourceType @map("source_type")
  sourceId   String?            @map("source_id") @db.Uuid
  statement  String?
  addedBy    String             @map("added_by") @db.Uuid
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("evidence_links")
}

// P9-04: Enforcement (Backend PRD 21.4, A.9). Every warning, restriction and suspension is one of
// these rows; an action ends by status, never by removal. Foreign keys are in the migration.
model EnforcementAction {
  id                String                @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  type              EnforcementActionType
  reason            String
  /// LADDER, SEVERE_EVENT or ADMIN (database CHECK).
  trigger           String
  /// WARNING, RESTRICTION or SUSPENSION for ladder actions (database CHECK).
  ladderLevel       String?               @map("ladder_level")
  caseRef           String?               @map("case_ref")
  actorType         AuditActorType        @map("actor_type")
  actorId           String?               @map("actor_id") @db.Uuid
  startsAt          DateTime              @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime?             @map("ends_at") @db.Timestamptz(3)
  status            RestrictionStatus     @default(ACTIVE)
  safetyCritical    Boolean               @default(false) @map("safety_critical")
  targetBadge       BadgeType?            @map("target_badge")
  targetType        String?               @map("target_type")
  targetId          String?               @map("target_id") @db.Uuid
  userStatusBefore  UserStatus?           @map("user_status_before")
  appealRequestedAt DateTime?             @map("appeal_requested_at") @db.Timestamptz(3)
  appealNote        String?               @map("appeal_note")
  appealDueAt       DateTime?             @map("appeal_due_at") @db.Timestamptz(3)
  /// UPHELD or REVOKED (database CHECK).
  appealOutcome     String?               @map("appeal_outcome")
  appealDecidedBy   String?               @map("appeal_decided_by") @db.Uuid
  appealDecidedAt   DateTime?             @map("appeal_decided_at") @db.Timestamptz(3)
  approvalRequestId String?               @map("approval_request_id") @db.Uuid
  endedReason       String?               @map("ended_reason")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  causes EnforcementActionEvent[]

  @@index([userId, status], map: "enforcement_actions_user_status_idx")
  @@map("enforcement_actions")
}

model EnforcementActionEvent {
  enforcementActionId String            @map("enforcement_action_id") @db.Uuid
  action              EnforcementAction @relation(fields: [enforcementActionId], references: [id], onDelete: Restrict)
  reliabilityEventId  String            @map("reliability_event_id") @db.Uuid

  @@id([enforcementActionId, reliabilityEventId])
  @@map("enforcement_action_events")
}

// P9-04: A case that needs an admin decision before any action (Backend PRD 21.4): the points
// reached the admin-review threshold, or a severe event. One open review per user and trigger.
model EnforcementReview {
  id                String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  /// LADDER_ADMIN_REVIEW or SEVERE_EVENT (database CHECK).
  trigger           String
  reason            String
  caseRef           String?   @map("case_ref")
  points            Int?
  /// OPEN, ACTIONED or DISMISSED (database CHECK).
  status            String    @default("OPEN")
  decidedBy         String?   @map("decided_by") @db.Uuid
  decidedAt         DateTime? @map("decided_at") @db.Timestamptz(3)
  decisionNote      String?   @map("decision_note")
  resultingActionId String?   @map("resulting_action_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([status, createdAt], map: "enforcement_reviews_status_created_idx")
  @@map("enforcement_reviews")
}

// P9-05: Earned badges (Backend PRD 21.5, A.9). A cache of rules computed from source rows by
// BadgeService; a badge ends with `revoked_at`, never by removal. One live badge per kind per user
// (partial unique index in the migration). The foreign key is in the migration.
model UserBadge {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  badge          BadgeType
  awardedAt      DateTime  @map("awarded_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason  String?   @map("revoked_reason")
  reasonSnapshot Json      @map("reason_snapshot")

  @@index([userId], map: "user_badges_user_idx")
  @@map("user_badges")
}

// P9-07: The runner's exact position while an errand is active (Backend PRD 17.3, A.7). Transient:
// a retention job removes rows after LOCATION_HISTORY_RETENTION_DAYS. The point is private and is
// written and read with raw SQL only; the API returns a rounded point and a freshness label.
model LocationRecord {
  id             String                               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  assignmentId   String                               @map("assignment_id") @db.Uuid
  userId         String                               @map("user_id") @db.Uuid
  point          Unsupported("geography(Point,4326)")
  accuracyMeters Decimal?                             @map("accuracy_meters") @db.Decimal(7, 1)
  capturedAt     DateTime                             @map("captured_at") @db.Timestamptz(3)
  receivedAt     DateTime                             @default(dbgenerated("clock_timestamp()")) @map("received_at") @db.Timestamptz(3)

  @@index([assignmentId, capturedAt(sort: Desc)], map: "location_records_assignment_captured_idx")
  @@index([capturedAt], map: "location_records_captured_idx")
  @@map("location_records")
}

// P9-06: A read-only link to an active errand (Backend PRD 17.5, A.9). Only a keyed hash of the
// token is stored. Foreign keys are in the migration.
model TrustedContactShare {
  id              String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  errandId        String             @map("errand_id") @db.Uuid
  createdBy       String             @map("created_by") @db.Uuid
  tokenHash       String             @unique(map: "trusted_contact_shares_token_hash_unique") @map("token_hash")
  status          TrustedShareStatus @default(ACTIVE)
  expiresAt       DateTime           @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime?          @map("revoked_at") @db.Timestamptz(3)
  viewCount       Int                @default(0) @map("view_count")
  lastViewedAt    DateTime?          @map("last_viewed_at") @db.Timestamptz(3)
  concernRaisedAt DateTime?          @map("concern_raised_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(3)

  @@index([errandId, status], map: "trusted_contact_shares_errand_status_idx")
  @@map("trusted_contact_shares")
}

// P9-08: Risk flags (Backend PRD 21.6, A.9). A signal for an admin to review; it never blocks a
// user by itself. One open flag per signal and subject (partial unique index in the migration):
// the same signal again raises `occurrences`. Foreign keys are in the migration.
model RiskFlag {
  id          String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId      String?        @map("user_id") @db.Uuid
  errandId    String?        @map("errand_id") @db.Uuid
  signal      String
  subjectKey  String?        @map("subject_key")
  details     Json?
  status      RiskFlagStatus @default(OPEN)
  occurrences Int            @default(1)
  lastSeenAt  DateTime       @default(dbgenerated("clock_timestamp()")) @map("last_seen_at") @db.Timestamptz(3)
  reviewedBy  String?        @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  reviewNote  String?        @map("review_note")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(3)

  @@index([status, createdAt], map: "risk_flags_status_created_idx")
  @@map("risk_flags")
}

// ---------------------------------------------------------------------------------------------
// P10-01: Platform billing (Backend PRD 22, A.10). Urgent.ng's own products only. Every table is
// never deleted: money rows change by status. Foreign keys, partial unique indexes and the
// immutability of a completed refund are in the migration.
// ---------------------------------------------------------------------------------------------
model Order {
  id             String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  type           OrderType
  productId      String      @map("product_id") @db.Uuid
  priceVersionId String      @map("price_version_id") @db.Uuid
  amountMinor    BigInt      @map("amount_minor")
  currency       String      @default("NGN") @db.Char(3)
  status         OrderStatus @default(PENDING)
  targetErrandId String?     @map("target_errand_id") @db.Uuid
  idempotencyKey String      @map("idempotency_key")
  metadata       Json?
  paidAt         DateTime?   @map("paid_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, status], map: "orders_user_status_idx")
  @@map("orders")
}

model Payment {
  id                String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  provider          String
  providerReference String        @map("provider_reference")
  status            PaymentStatus @default(INITIATED)
  amountMinor       BigInt        @map("amount_minor")
  authorizationUrl  String?       @map("authorization_url")
  authorizationCode String?       @map("authorization_code")
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([orderId], map: "payments_order_idx")
  @@map("payments")
}

model PaymentAttempt {
  id               String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  paymentId        String   @map("payment_id") @db.Uuid
  kind             String
  status           String
  providerResponse Json?    @map("provider_response")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([paymentId, createdAt], map: "payment_attempts_payment_idx")
  @@map("payment_attempts")
}

model Refund {
  id                String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  paymentId         String         @map("payment_id") @db.Uuid
  amountMinor       BigInt         @map("amount_minor")
  reason            String
  status            RefundStatus   @default(REQUESTED)
  requestedByType   AuditActorType @map("requested_by_type")
  requestedById     String?        @map("requested_by_id") @db.Uuid
  approvalRequestId String?        @map("approval_request_id") @db.Uuid
  approvedBy        String?        @map("approved_by") @db.Uuid
  providerRefundRef String?        @map("provider_refund_ref")
  failureReason     String?        @map("failure_reason")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([paymentId], map: "refunds_payment_idx")
  @@map("refunds")
}

model Entitlement {
  id         String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  type       EntitlementType
  /// ORDER, SUBSCRIPTION or ADMIN (database CHECK).
  source     String
  sourceId   String?         @map("source_id") @db.Uuid
  quantity   Int             @default(1)
  validFrom  DateTime        @map("valid_from") @db.Timestamptz(3)
  validUntil DateTime?       @map("valid_until") @db.Timestamptz(3)
  revokedAt  DateTime?       @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, type, validUntil], map: "entitlements_user_type_until_idx")
  @@map("entitlements")
}

model Subscription {
  id                 String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  status             SubscriptionStatus
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(3)
  graceEndsAt        DateTime?          @map("grace_ends_at") @db.Timestamptz(3)
  autoRenew          Boolean            @default(false) @map("auto_renew")
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  latestOrderId      String?            @map("latest_order_id") @db.Uuid
  renewalAttemptedAt DateTime?          @map("renewal_attempted_at") @db.Timestamptz(3)
  version            Int                @default(0)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([currentPeriodEnd], map: "subscriptions_period_end_idx")
  @@map("subscriptions")
}

model Boost {
  id          String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  errandId    String      @map("errand_id") @db.Uuid
  orderId     String      @unique(map: "boosts_order_unique") @map("order_id") @db.Uuid
  status      BoostStatus @default(PURCHASED)
  activatesAt DateTime?   @map("activates_at") @db.Timestamptz(3)
  expiresAt   DateTime?   @map("expires_at") @db.Timestamptz(3)
  endedReason String?     @map("ended_reason")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("boosts")
}

model WebhookEvent {
  id               String                  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  provider         String
  eventId          String                  @map("event_id")
  eventType        String                  @map("event_type")
  signatureValid   Boolean                 @map("signature_valid")
  processingStatus WebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  payloadHash      String                  @map("payload_hash")
  payloadRef       String?                 @map("payload_ref")
  failureReason    String?                 @map("failure_reason")
  duplicateCount   Int                     @default(0) @map("duplicate_count")
  receivedAt       DateTime                @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt      DateTime?               @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, eventId], map: "webhook_events_provider_event_unique")
  @@map("webhook_events")
}

// P11-01: Four-eyes approval (Backend PRD 24.5). An admin asks for a high-impact action; a DIFFERENT
// admin holding the approving permission approves or rejects it, and the action runs only then.
// Refunds keep their own two-step flow on the refund row. Foreign keys are in the migration.
enum ApprovalKind {
  PERMANENT_SUSPENSION
  ADMIN_ROLE_CHANGE
  PRICE_CHANGE
  KILL_SWITCH
  CONFIG_CHANGE
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  EXECUTED
  FAILED
  REJECTED
  CANCELLED
  EXPIRED
}

model ApprovalRequest {
  id            String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  kind          ApprovalKind
  status        ApprovalRequestStatus @default(PENDING)
  requestedBy   String         @map("requested_by") @db.Uuid
  reasonCode    String         @map("reason_code")
  reasonText    String?        @map("reason_text")
  summary       String
  targetType    String?        @map("target_type")
  targetId      String?        @map("target_id")
  payload       Json
  decidedBy     String?        @map("decided_by") @db.Uuid
  decisionNote  String?        @map("decision_note")
  decidedAt     DateTime?      @map("decided_at") @db.Timestamptz(3)
  executedAt    DateTime?      @map("executed_at") @db.Timestamptz(3)
  result        Json?
  failureReason String?        @map("failure_reason")
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt], map: "approval_requests_status_created_idx")
  @@index([kind, status], map: "approval_requests_kind_status_idx")
  @@map("approval_requests")
}

// P11-04: a note an admin leaves on a dispute, report, user or errand. Never deleted.
// Foreign keys are in the migration.
model AdminCaseNote {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt], map: "admin_case_notes_entity_idx")
  @@map("admin_case_notes")
}

// P11-07: what each sweeper last did, written by the scheduler process after every sweep.
model SweeperRun {
  name           String    @id
  lastStartedAt  DateTime? @map("last_started_at") @db.Timestamptz(3)
  lastFinishedAt DateTime? @map("last_finished_at") @db.Timestamptz(3)
  lastDurationMs Int?      @map("last_duration_ms")
  lastProcessed  Int       @default(0) @map("last_processed")
  lastError      String?   @map("last_error")
  lastErrorAt    DateTime? @map("last_error_at") @db.Timestamptz(3)
  runs           BigInt    @default(0)
  failures       BigInt    @default(0)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sweeper_runs")
}

// P11-07: access, correction and deletion requests, tracked to their due date. Never deleted.
// Foreign keys are in the migration.
model DataSubjectRequest {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  type        DsrType
  status      DsrStatus @default(OPEN)
  channel     String    @default("SUPPORT")
  summary     String
  dueAt       DateTime  @map("due_at") @db.Timestamptz(3)
  assignedTo  String?   @map("assigned_to") @db.Uuid
  resolution  String?
  resolvedBy  String?   @map("resolved_by") @db.Uuid
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, dueAt], map: "data_subject_requests_status_due_idx")
  @@map("data_subject_requests")
}
