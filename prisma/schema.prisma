// ========================================
// MODELS
// ========================================

// P1-01: Demo migration patterns

// ---------------------------------------------------------------------------
// Models. Partial and expression indexes, CHECK constraints, triggers and the
// uuid_generate_v7() function live in the SQL migrations because Prisma cannot
// express them (Backend PRD section 26.1). Never edit an applied migration.
// ---------------------------------------------------------------------------

// P1-02: Config store and pricing tables
model ConfigValue {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key              String
  valueJson        Json      @map("value_json")
  version          Int       @default(1)
  effectiveFrom    DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  updatedByAdminId String?   @map("updated_by_admin_id") @db.Uuid
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([key, effectiveFrom(sort: Desc)], map: "config_values_key_effective_idx")
  @@map("config_values")
}

model CommercialProduct {
  id            String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code          String
  name          String
  description   String?
  type          String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  priceVersions PriceVersion[]

  @@map("commercial_products")
}

model PriceVersion {
  id               String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId        String            @map("product_id") @db.Uuid
  amountKobo       BigInt            @map("amount_kobo")
  currency         String            @default("NGN") @db.Char(3)
  effectiveFrom    DateTime          @map("effective_from") @db.Timestamptz(6)
  notes            String?
  createdByAdminId String?           @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  product          CommercialProduct @relation(fields: [productId], references: [id], onUpdate: NoAction)

  @@unique([productId, effectiveFrom], map: "price_versions_product_effective_unique")
  @@index([productId, effectiveFrom(sort: Desc)], map: "price_versions_product_effective_idx")
  @@map("price_versions")
}

// P1-03: Audit log (append-only: UPDATE and DELETE are rejected by triggers)
model AuditLog {
  id         String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  action     String
  entityType String?        @map("entity_type")
  entityId   String?        @map("entity_id") @db.Uuid
  requestId  String?        @map("request_id")
  beforeHash String?        @map("before_hash")
  afterHash  String?        @map("after_hash")
  reasonCode String?        @map("reason_code")
  metadata   Json?
  ip         String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorType, actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// P1-04: Outbox (transient table: only the retention role may delete)
model OutboxEvent {
  id                  String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  eventType           String       @map("event_type")
  aggregateType       String?      @map("aggregate_type")
  aggregateId         String?      @map("aggregate_id") @db.Uuid
  payload             Json
  occurredAt          DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  status              OutboxStatus @default(PENDING)
  attempts            Int          @default(0)
  availableAt         DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt         DateTime?    @map("processed_at") @db.Timestamptz(3)
  lastError           String?      @map("last_error")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  processingStartedAt DateTime?    @map("processing_started_at") @db.Timestamptz(6)

  @@index([aggregateType, aggregateId, occurredAt, id], map: "outbox_events_aggregate_idx")
  @@map("outbox_events")
}

// P1-05: Idempotency keys (transient table: only the retention role may delete)
model IdempotencyKey {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  operation      String
  key            String
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  failedAt       DateTime? @map("failed_at") @db.Timestamptz(6)

  @@unique([userId, operation, key], map: "idempotency_keys_user_operation_key_unique")
  @@index([createdAt], map: "idempotency_keys_created_at_idx")
  @@map("idempotency_keys")
}

// P2-01: Identity and access

model User {
  id                  String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name                String
  firstName           String     @map("first_name")
  lastName            String     @map("last_name")
  email               String?    @unique(map: "users_email_unique")
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  phoneE164           String?    @unique(map: "users_phone_unique") @map("phone_e164")
  phoneVerifiedAt     DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  passwordHash        String     @map("password_hash")
  googleSubject       String?    @unique(map: "users_google_subject_unique") @map("google_subject")
  status              UserStatus @default(ACTIVE)
  startMode           StartMode? @map("start_mode")
  failedLoginCount    Int        @default(0) @map("failed_login_count")
  firstFailedLoginAt  DateTime?  @map("first_failed_login_at") @db.Timestamptz(3)
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(3)
  deactivatedAt       DateTime?  @map("deactivated_at") @db.Timestamptz(3)
  deletionRequestedAt DateTime?  @map("deletion_requested_at") @db.Timestamptz(3)
  deletionScheduledAt DateTime?  @map("deletion_scheduled_at") @db.Timestamptz(3)
  anonymisedAt        DateTime?  @map("anonymised_at") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(3)

  // Relations
  profile              Profile?
  authSessions         AuthSession[]
  consentRecords       ConsentRecord[]
  blocksGiven          Block[]                  @relation("BlockerRelation")
  blocksReceived       Block[]                  @relation("BlockedRelation")
  notificationPrefs    NotificationPreference[]
  devices              Device[]
  restrictions         UserRestriction[]
  media                Media[]
  runnerProfile        RunnerProfile?
  verificationAttempts VerificationAttempt[]
  errands              Errand[]                 @relation("ErrandRequester")
  savedErrands         SavedErrand[]            @relation("SavedErrands")
  offersAsRunner       Offer[]                  @relation("OfferRunner")
  offersAsRequester    Offer[]                  @relation("OfferRequester")
  negotiationEvents    NegotiationEvent[]       @relation("NegotiationActor")
  assignmentsAsRequester Assignment[]           @relation("AssignmentRequester")
  assignmentsAsRunner    Assignment[]           @relation("AssignmentRunner")
  executionProblems      ExecutionProblem[]     @relation("ProblemReporter")
  changeRequestsMade     ChangeRequest[]        @relation("ChangeRequester")
  changeRequestsAnswered ChangeRequest[]        @relation("ChangeResponder")
  conversationsAsRequester Conversation[]       @relation("ConversationRequester")
  conversationsAsRunner    Conversation[]       @relation("ConversationRunner")
  conversationParticipants ConversationParticipant[]
  messagesSent             Message[]            @relation("MessageSender")
  notifications            Notification[]
  ratingsGiven             Rating[]             @relation("RatingRater")
  ratingsReceived          Rating[]             @relation("RatingRatee")
  stats                    UserStats?

  @@index([status], map: "users_status_idx")
  @@index([deletionScheduledAt], map: "users_deletion_scheduled_idx")
  @@map("users")
}

model Profile {
  userId       String    @id @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  photoMediaId String?   @map("photo_media_id") @db.Uuid
  photo        Media?    @relation("ProfilePhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)
  homePoint    String?   @map("home_point") @db.VarChar
  homeArea     String?   @map("home_area")
  bio          String?   @db.VarChar(300)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@map("profiles")
}

model AuthSession {
  id                  String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  familyId            String    @map("family_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash")
  userAgent           String?   @map("user_agent")
  ip                  String?   @db.Inet
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, revokedAt], map: "auth_sessions_user_revoked_idx")
  @@index([familyId], map: "auth_sessions_family_idx")
  @@index([expiresAt], map: "auth_sessions_expires_idx")
  @@map("auth_sessions")
}

model PolicyVersion {
  id                   String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  type                 ConsentType
  version              String
  documentRef          String      @map("document_ref")
  publishedAt          DateTime    @map("published_at") @db.Timestamptz(3)
  requiresReacceptance Boolean     @default(false) @map("requires_reacceptance")
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([type, version], map: "policy_versions_type_version_unique")
  @@map("policy_versions")
}

model ConsentRecord {
  id              String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  consentType     ConsentType @map("consent_type")
  documentVersion String      @map("document_version")
  acceptedAt      DateTime    @map("accepted_at") @db.Timestamptz(3)
  withdrawnAt     DateTime?   @map("withdrawn_at") @db.Timestamptz(3)
  ipAddress       String?     @map("ip_address") @db.Inet
  userAgent       String?     @map("user_agent")

  @@index([userId, consentType, acceptedAt], map: "consent_records_user_type_idx")
  @@map("consent_records")
}

model Block {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  blockerId String    @map("blocker_id") @db.Uuid
  blocker   User      @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Restrict)
  blockedId String    @map("blocked_id") @db.Uuid
  blocked   User      @relation("BlockedRelation", fields: [blockedId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([blockerId, blockedId], map: "blocks_blocker_blocked_unique")
  @@map("blocks")
}

model BlocklistEntry {
  id                  String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  type                BlocklistType
  valueHash           String        @map("value_hash")
  reason              String
  sourceEnforcementId String?       @map("source_enforcement_id") @db.Uuid
  expiresAt           DateTime?     @map("expires_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz(3)

  @@unique([type, valueHash], map: "blocklist_entries_type_hash_unique")
  @@map("blocklist_entries")
}

model NotificationPreference {
  id              String               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  channel         NotificationChannel
  category        NotificationCategory
  enabled         Boolean
  quietHoursStart DateTime?            @map("quiet_hours_start") @db.Time
  quietHoursEnd   DateTime?            @map("quiet_hours_end") @db.Time
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?            @map("deleted_at") @db.Timestamptz(3)

  @@unique([userId, channel, category], map: "notification_prefs_user_channel_category_unique")
  @@map("notification_preferences")
}

model Device {
  id         String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  type       DeviceType
  pushToken  String     @map("push_token")
  active     Boolean    @default(true)
  lastSeenAt DateTime?  @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz(3)

  @@index([userId], map: "devices_user_idx")
  @@index([pushToken], map: "devices_push_token_idx")
  @@map("devices")
}

model UserRestriction {
  id                  String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  user                User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  type                UserRestrictionType
  status              RestrictionStatus   @default(ACTIVE)
  startsAt            DateTime            @map("starts_at") @db.Timestamptz(3)
  endsAt              DateTime?           @map("ends_at") @db.Timestamptz(3)
  enforcementActionId String              @map("enforcement_action_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?           @map("deleted_at") @db.Timestamptz(3)

  @@index([userId, status, type], map: "user_restrictions_user_status_type_idx")
  @@index([endsAt], map: "user_restrictions_ends_at_idx")
  @@map("user_restrictions")
}

// P2-06: Admin identity and RBAC

model Admin {
  id                 String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email              String      @unique(map: "admins_email_key")
  displayName        String      @map("display_name")
  passwordHash       String      @map("password_hash")
  status             AdminStatus @default(INVITED)
  mfaEnabled         Boolean     @default(false) @map("mfa_enabled")
  mfaSecretEncrypted String?     @map("mfa_secret_encrypted")
  inviteTokenHash    String?     @unique(map: "admins_invite_token_hash_key") @map("invite_token_hash")
  inviteExpiresAt    DateTime?   @map("invite_expires_at") @db.Timestamptz(3)
  invitedBy          String?     @map("invited_by") @db.Uuid
  failedLoginCount   Int         @default(0) @map("failed_login_count")
  firstFailedLoginAt DateTime?   @map("first_failed_login_at") @db.Timestamptz(3)
  lockedUntil        DateTime?   @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?   @map("last_login_at") @db.Timestamptz(3)
  deactivatedAt      DateTime?   @map("deactivated_at") @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?   @map("deleted_at") @db.Timestamptz(3)

  roleAssignments AdminRoleAssignment[]
  sessions        AdminSession[]
  authEvents      AdminAuthEvent[]

  @@index([status], map: "admins_status_idx")
  @@map("admins")
}

model AdminRole {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name        String    @unique(map: "admin_roles_name_key")
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  permissions AdminRolePermission[]
  assignments AdminRoleAssignment[]

  @@map("admin_roles")
}

model AdminPermission {
  key         String  @id
  description String?

  roles AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  id            String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  roleId        String          @map("role_id") @db.Uuid
  permissionKey String          @map("permission_key")
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz(3)
  role          AdminRole       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission    AdminPermission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@index([roleId], map: "admin_role_permissions_role_idx")
  @@map("admin_role_permissions")
}

model AdminRoleAssignment {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  role      AdminRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([adminId], map: "admin_role_assignments_admin_idx")
  @@map("admin_role_assignments")
}

model AdminSession {
  id                  String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  adminId             String    @map("admin_id") @db.Uuid
  admin               Admin     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  familyId            String    @map("family_id") @db.Uuid
  tokenHash           String    @unique(map: "admin_sessions_token_hash_key") @map("token_hash")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  userAgent           String?   @map("user_agent")
  ip                  String?   @db.Inet
  mfaVerifiedAt       DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([adminId, revokedAt], map: "admin_sessions_admin_revoked_idx")
  @@index([familyId], map: "admin_sessions_family_idx")
  @@index([expiresAt], map: "admin_sessions_expires_at_idx")
  @@map("admin_sessions")
}

model AdminAuthEvent {
  id        String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  adminId   String?            @map("admin_id") @db.Uuid
  admin     Admin?             @relation(fields: [adminId], references: [id], onDelete: Restrict)
  event     AdminAuthEventType
  email     String?
  reason    String?
  ip        String?            @db.Inet
  userAgent String?            @map("user_agent")
  requestId String?            @map("request_id")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([adminId, createdAt], map: "admin_auth_events_admin_created_idx")
  @@map("admin_auth_events")
}

// Reference data (Backend PRD A.5, section 11.2)
model Category {
  id                  String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key                 String    @unique(map: "categories_key_key")
  name                String
  requiresPickup      Boolean   @map("requires_pickup")
  requiresDestination Boolean   @map("requires_destination")
  sortOrder           Int       @default(0) @map("sort_order")
  isPopular           Boolean   @default(false) @map("is_popular")
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)

  errands Errand[]

  @@map("categories")
}

model ProhibitedItemRule {
  id            String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  category      String
  keyword       String
  description   String?
  status        String
  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz(3)
  policyVersion String    @map("policy_version")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([status, keyword], map: "prohibited_item_rules_status_keyword_idx")
  @@map("prohibited_item_rules")
}

// P3-01: Media (Backend PRD 23 and A.8). A row is created when an upload is requested; the
// object lives in storage under `storageKey`. The original upload is replaced by the processed
// copy when processing finishes.
model Media {
  id               String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  ownerId          String           @map("owner_id") @db.Uuid
  owner            User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  purpose          MediaPurpose
  storageKey       String           @unique(map: "media_storage_key_unique") @map("storage_key")
  mimeType         String           @map("mime_type")
  sizeBytes        BigInt           @map("size_bytes")
  checksum         String?
  width            Int?
  height           Int?
  status           MediaStatus      @default(PENDING)
  moderationStatus ModerationStatus @default(NONE) @map("moderation_status")
  thumbnailKey     String?          @map("thumbnail_key")
  rejectionReason  String?          @map("rejection_reason")
  confirmedAt      DateTime?        @map("confirmed_at") @db.Timestamptz(3)
  processedAt      DateTime?        @map("processed_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(3)

  profilePhotoOf       Profile[]             @relation("ProfilePhoto")
  verificationSelfieOf VerificationAttempt[]
  errandMedia          ErrandMedia[]
  executionEvents      ExecutionEvent[]
  executionProblems    ExecutionProblem[]
  checkpoints          Checkpoint[]
  messages             Message[]

  @@index([ownerId, purpose], map: "media_owner_purpose_idx")
  @@index([status], map: "media_status_idx")
  @@index([deletedAt], map: "media_deleted_at_idx")
  @@map("media")
}

// P4-01: Runner profile (Backend PRD 10.1). The operating area is one circle: centre + radius.
// The centre is a PostGIS geography point, written and read with raw SQL only.
model RunnerProfile {
  userId              String                               @id @map("user_id") @db.Uuid
  user                User                                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  transport           TransportMethod
  areaCenter          Unsupported("geography(Point,4326)") @map("area_center")
  areaRadiusKm        Decimal                              @default(5) @map("area_radius_km") @db.Decimal(4, 1)
  availability        RunnerAvailability                   @default(UNAVAILABLE)
  excludedCategoryIds String[]                             @default([]) @map("excluded_category_ids") @db.Uuid
  createdAt           DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?                            @map("deleted_at") @db.Timestamptz(3)

  @@index([areaCenter], type: Gist, map: "runner_profiles_area_center_idx")
  @@index([availability], map: "runner_profiles_availability_idx")
  @@map("runner_profiles")
}

// P4-02: One row per verification attempt (Backend PRD 10.2, A.3). The NIN and the selfie are
// never stored here: only masked attributes, the provider reference and a keyed hash of the
// identity (duplicate detection).
model VerificationAttempt {
  id                     String                     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId                 String                     @map("user_id") @db.Uuid
  user                   User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider               String
  providerRequestId      String?                    @map("provider_request_id")
  status                 VerificationStatus
  failureReason          VerificationFailureReason? @map("failure_reason")
  providerStatus         String?                    @map("provider_status")
  attemptNumber          Int                        @map("attempt_number")
  identityRefHmac        String?                    @map("identity_ref_hmac")
  maskedAttributes       Json?                      @map("masked_attributes")
  confidence             Decimal?                   @db.Decimal(5, 2)
  selfieMediaId          String?                    @map("selfie_media_id") @db.Uuid
  selfie                 Media?                     @relation(fields: [selfieMediaId], references: [id], onDelete: SetNull)
  countsAgainstAllowance Boolean                    @default(true) @map("counts_against_allowance")
  startedAt              DateTime                   @map("started_at") @db.Timestamptz(3)
  completedAt            DateTime?                  @map("completed_at") @db.Timestamptz(3)
  expiresAt              DateTime?                  @map("expires_at") @db.Timestamptz(3)
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?                  @map("deleted_at") @db.Timestamptz(3)

  @@index([userId, createdAt], map: "verification_attempts_user_created_idx")
  @@map("verification_attempts")
}

// Demo-gap: what the runner told us at verification (identity details, the ID document and a
// guarantor). Personal data: scrubbed on anonymisation, shown to admins on manual review.
// One submission per attempt. Foreign keys are in the migration.
enum IdDocumentType {
  NIN_SLIP
  VOTERS_CARD
  DRIVERS_LICENCE
  INTERNATIONAL_PASSPORT
}

enum GuarantorRelationship {
  FAMILY
  FRIEND
  EMPLOYER
  NEIGHBOUR
}

model VerificationSubmission {
  attemptId           String          @id @map("attempt_id") @db.Uuid
  userId              String          @map("user_id") @db.Uuid
  firstName           String?         @map("first_name")
  lastName            String?         @map("last_name")
  dateOfBirth         DateTime?       @map("date_of_birth") @db.Date
  addressLine         String?         @map("address_line")
  lga                 String?
  idDocumentType      IdDocumentType? @map("id_document_type")
  idDocumentMediaId   String?         @map("id_document_media_id") @db.Uuid
  guarantorName       String?         @map("guarantor_name")
  guarantorRelation   GuarantorRelationship? @map("guarantor_relationship")
  guarantorPhone      String?         @map("guarantor_phone_e164")
  anonymisedAt        DateTime?       @map("anonymised_at") @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId], map: "verification_submissions_user_idx")
  @@map("verification_submissions")
}

// P5-01: Errands (Backend PRD 11 and A.5). Status-dependent rules are CHECK constraints in the
// migration. `searchVector` is a generated column the database fills; never write it.
model Errand {
  id                         String                                @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  requesterId                String                                @map("requester_id") @db.Uuid
  requester                  User                                  @relation("ErrandRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  categoryId                 String                                @map("category_id") @db.Uuid
  category                   Category                              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title                      String
  description                String
  instructions               String?
  status                     ErrandStatus                          @default(DRAFT)
  statusBeforeDispute        ErrandStatus?                         @map("status_before_dispute")
  priority                   ErrandPriority                        @default(STANDARD)
  timeMode                   TimeMode?                             @map("time_mode")
  scheduledAt                DateTime?                             @map("scheduled_at") @db.Timestamptz(3)
  suggestedBudgetMinor       BigInt?                               @map("suggested_budget_minor")
  itemSize                   ItemSize?                             @map("item_size")
  itemValueMinor             BigInt?                               @map("item_value_minor")
  prohibitedItemsConfirmedAt DateTime?                             @map("prohibited_items_confirmed_at") @db.Timestamptz(3)
  prohibitedPolicyVersion    String?                               @map("prohibited_policy_version")
  publishedAt                DateTime?                             @map("published_at") @db.Timestamptz(3)
  expiresAt                  DateTime?                             @map("expires_at") @db.Timestamptz(3)
  extendedAt                 DateTime?                             @map("extended_at") @db.Timestamptz(3)
  autoCompleteAt             DateTime?                             @map("auto_complete_at") @db.Timestamptz(3)
  deliveredAt                DateTime?                             @map("delivered_at") @db.Timestamptz(3)
  completedAt                DateTime?                             @map("completed_at") @db.Timestamptz(3)
  cancelledAt                DateTime?                             @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason         ErrandCancellationReason?             @map("cancellation_reason")
  cancellationNote           String?                               @map("cancellation_note")
  cancelledBy                String?                               @map("cancelled_by") @db.Uuid
  cancelledByType            AuditActorType?                       @map("cancelled_by_type")
  /// Approximate point of the primary location (pickup, else destination). The feed index.
  feedPoint                  Unsupported("geography(Point,4326)")? @map("feed_point")
  /// Live offers on this errand. Kept by the offer module (Phase 6).
  offerCount                 Int                                   @default(0) @map("offer_count")
  /// Changes only on a material edit (Backend PRD 11.5); offers compare against it.
  materialVersion            Int                                   @default(0) @map("material_version")
  searchVector               Unsupported("tsvector")?              @map("search_vector")
  version                    Int                                   @default(0)
  createdAt                  DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                  DateTime?                             @map("deleted_at") @db.Timestamptz(3)

  locations         ErrandLocation[]
  contact           ErrandContact?
  versions          ErrandVersion[]
  media             ErrandMedia[]
  saves             SavedErrand[]
  statusHistory     ErrandStatusHistory[]
  offers            Offer[]
  negotiationEvents NegotiationEvent[]
  assignments       Assignment[]
  executionEvents   ExecutionEvent[]
  conversations     Conversation[]

  @@index([status, categoryId], map: "errands_status_category_idx")
  @@index([requesterId, status], map: "errands_requester_status_idx")
  @@index([createdAt], map: "errands_created_at_idx")
  @@index([feedPoint], type: Gist, map: "errands_feed_point_idx")
  @@index([searchVector], type: Gin, map: "errands_search_vector_idx")
  @@map("errands")
}

model ErrandLocation {
  id          String                               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  errandId    String                               @map("errand_id") @db.Uuid
  errand      Errand                               @relation(fields: [errandId], references: [id], onDelete: Restrict)
  type        LocationType
  exactPoint  Unsupported("geography(Point,4326)") @map("exact_point")
  approxPoint Unsupported("geography(Point,4326)") @map("approx_point")
  addressText String?                              @map("address_text")
  landmark    String?
  area        String
  lga         String?
  state       String?
  source      LocationSource
  createdAt   DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?                            @map("deleted_at") @db.Timestamptz(3)

  @@index([approxPoint], type: Gist, map: "errand_locations_approx_idx")
  @@index([exactPoint], type: Gist, map: "errand_locations_exact_idx")
  @@map("errand_locations")
}

/// Pickup and drop-off contacts. Every value is AES-256-GCM ciphertext (`v1.<keyId>...`).
model ErrandContact {
  errandId        String    @id @map("errand_id") @db.Uuid
  errand          Errand    @relation(fields: [errandId], references: [id], onDelete: Restrict)
  pickupName      String?   @map("pickup_name")
  pickupPhone     String?   @map("pickup_phone")
  dropoffName     String?   @map("dropoff_name")
  dropoffPhone    String?   @map("dropoff_phone")
  encryptionKeyId String    @map("encryption_key_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@map("errand_contacts")
}

/// Snapshot of the values an errand had before a material edit (kept for disputes).
model ErrandVersion {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  errandId      String   @map("errand_id") @db.Uuid
  errand        Errand   @relation(fields: [errandId], references: [id], onDelete: Restrict)
  version       Int
  snapshot      Json
  changedFields String[] @map("changed_fields")
  changedBy     String   @map("changed_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([errandId, version], map: "errand_versions_errand_version_unique")
  @@map("errand_versions")
}

model ErrandMedia {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  errandId  String    @map("errand_id") @db.Uuid
  errand    Errand    @relation(fields: [errandId], references: [id], onDelete: Restrict)
  mediaId   String    @map("media_id") @db.Uuid
  media     Media     @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  position  Int       @default(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([errandId], map: "errand_media_errand_idx")
  @@map("errand_media")
}

model SavedErrand {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation("SavedErrands", fields: [userId], references: [id], onDelete: Restrict)
  errandId  String    @map("errand_id") @db.Uuid
  errand    Errand    @relation(fields: [errandId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([userId, createdAt], map: "saved_errands_user_created_idx")
  @@map("saved_errands")
}

/// One row per status change (Backend PRD 11.6): who, from what, to what, why.
model ErrandStatusHistory {
  id         String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  errandId   String         @map("errand_id") @db.Uuid
  errand     Errand         @relation(fields: [errandId], references: [id], onDelete: Restrict)
  fromStatus ErrandStatus?  @map("from_status")
  toStatus   ErrandStatus   @map("to_status")
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  reason     String?
  version    Int
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([errandId, createdAt], map: "errand_status_history_errand_idx")
  @@map("errand_status_history")
}

model Offer {
  id                      String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  errandId                String             @map("errand_id") @db.Uuid
  errand                  Errand             @relation(fields: [errandId], references: [id], onDelete: Restrict)
  runnerId                String             @map("runner_id") @db.Uuid
  runner                  User               @relation("OfferRunner", fields: [runnerId], references: [id], onDelete: Restrict)
  requesterId             String             @map("requester_id") @db.Uuid
  requester               User               @relation("OfferRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  amountMinor             BigInt             @map("amount_minor")
  durationMinutes         Int                @map("duration_minutes")
  availabilityConfirmedAt DateTime?          @map("availability_confirmed_at") @db.Timestamptz(3)
  message                 String?
  status                  OfferStatus        @default(ACTIVE)
  closeReason             OfferCloseReason?  @map("close_reason")
  awaitingParty           OfferAwaitingParty @default(REQUESTER) @map("awaiting_party")
  needsReconfirmation     Boolean            @default(false) @map("needs_reconfirmation")
  conversationId          String?            @map("conversation_id") @db.Uuid
  version                 Int                @default(0)
  selectedAt              DateTime?          @map("selected_at") @db.Timestamptz(3)
  withdrawnAt             DateTime?          @map("withdrawn_at") @db.Timestamptz(3)
  closedAt                DateTime?          @map("closed_at") @db.Timestamptz(3)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?          @map("deleted_at") @db.Timestamptz(3)

  negotiationEvents NegotiationEvent[]
  assignments       Assignment[]
  conversations     Conversation[]

  @@index([errandId, status, createdAt], map: "offers_errand_status_created_idx")
  @@index([runnerId, status, createdAt], map: "offers_runner_status_created_idx")
  @@index([requesterId, status, createdAt], map: "offers_requester_status_created_idx")
  @@index([errandId, runnerId], map: "offers_errand_runner_idx")
  @@map("offers")
}

model OfferDailyCounter {
  userId    String   @map("user_id") @db.Uuid
  dayLagos  String   @map("day_lagos")
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([userId, dayLagos], map: "offer_daily_counters_pkey")
  @@map("offer_daily_counters")
}

model NegotiationEvent {
  id                   String               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  errandId             String               @map("errand_id") @db.Uuid
  errand               Errand               @relation(fields: [errandId], references: [id], onDelete: Restrict)
  offerId              String               @map("offer_id") @db.Uuid
  offer                Offer                @relation(fields: [offerId], references: [id], onDelete: Restrict)
  actorUserId          String               @map("actor_user_id") @db.Uuid
  actor                User                 @relation("NegotiationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
